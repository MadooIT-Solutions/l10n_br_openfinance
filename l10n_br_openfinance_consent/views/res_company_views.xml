<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_form_inherit_open_finance_consent" model="ir.ui.view">
        <field name="name">res.company.form.inherit.open.finance.consent</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_openfinance.view_res_company_form_inherit_open_finance"/>
        <field name="arch" type="xml">
            <group name="open_finance_configs" position="after">
                <group string="Consentimentos">
                    <field name="open_finance_consent_ids">
                        <list limit="10">
                            <field name="display_name"/>
                            <field name="status" widget="badge"/>
                            <field name="scope"/>
                            <field name="date_expiration"/>
                        </list>
                    </field>
                </group>
            </group>
        </field>
    </record>
</odoo>
