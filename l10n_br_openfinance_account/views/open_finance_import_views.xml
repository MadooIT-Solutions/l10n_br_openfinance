<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_open_finance_import_form" model="ir.ui.view">
        <field name="name">open.finance.import.form</field>
        <field name="model">open.finance.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="config_id" required="1"/>
                        <field name="journal_ids" widget="many2many_tags" required="1"/>
                        <field name="file" filename="filename" required="1"/>
                        <field name="filename"/>
                    </group>
                    <footer>
                        <button name="action_import_file" string="Importar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_finance_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Extrato (Manual)</field>
        <field name="res_model">open.finance.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
