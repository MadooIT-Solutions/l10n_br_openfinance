<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_form_inherit_open_finance" model="ir.ui.view">
        <field name="name">res.company.form.inherit.open.finance</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Open Finance" name="open_finance">
                    <group string="Instituições Financeiras" name="open_finance_configs">
                        <field name="open_finance_config_ids">
                            <list limit="10">
                                <field name="institution_name"/>
                                <field name="environment"/>
                                <field name="certificate_id"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
